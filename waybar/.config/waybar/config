{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 4,
    "margin-top": 8,
    "margin-left": 8,
    "margin-right": 8,

    "modules-left": ["sway/workspaces", "sway/mode", "sway/window"],
    "modules-center": ["mpris", "clock", "custom/snip"],
    "modules-right": ["idle_inhibitor", "pulseaudio", "network", "backlight", "battery", "tray"],

    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{name}"
    },
    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "sway/window": {
        "format": "{title}",
        "max-length": 60
    },
    "mpris": {
        "format": "<span font_size='140%'></span>  {dynamic}",
        "format-paused": "<span font_size='140%'></span>  {dynamic}",
        "format-stopped": "<span font_size='140%'></span>  stopped",
        "dynamic-order": ["title", "artist"],
        "dynamic-separator": " - ",
        "title-len": 25,
        "artist-len": 20,
        "max-length": 40,
        "tooltip-format": "{player} : {dynamic}"
    },
    "clock": {
        "format": "{:%H:%M   %a %d %b}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><big>{calendar}</big></tt>"
    },
    "custom/snip": {
        "format": "<span font_size='140%'></span>",
        "tooltip-format": "Snip screenshot to clipboard",
        "on-click": "grim -g \"$(slurp)\" - | wl-copy"
    },
    "idle_inhibitor": {
        "format": "<span font_size='140%'>{icon}</span>",
        "tooltip-format-activated": "Stay-awake mode on (click to allow sleep)",
        "tooltip-format-deactivated": "Stay-awake mode off (click to keep awake)",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "backlight": {
        "format": "<span font_size='140%'>{icon}</span>  {percent}%",
        "format-icons": ["", ""]
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "<span font_size='140%'>{icon}</span>  {capacity}%",
        "format-charging": "<span font_size='140%'></span>  {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },
    "network": {
        "format-wifi": "<span font_size='140%'></span>  {signalStrength}%",
        "format-ethernet": "<span font_size='140%'></span>  {ifname}",
        "format-disconnected": "<span font_size='140%'></span>  disconnected",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}"
    },
    "pulseaudio": {
        "format": "<span font_size='140%'>{icon}</span>  {volume}%",
        "format-muted": "<span font_size='140%'></span>  muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
    "tray": {
        "spacing": 10
    }
}
