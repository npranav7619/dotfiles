# mako config -- minimal, Catppuccin Mocha, Agave Nerd Font

font=Agave Nerd Font 11
background-color=#1e1e2e
text-color=#cdd6f4
border-color=#cba6f7
border-size=2
border-radius=8
padding=10
margin=10
width=350
height=110
anchor=top-right
default-timeout=5000
layer=overlay

[urgency=low]
border-color=#a6adc8

[urgency=normal]
border-color=#cba6f7

[urgency=high]
border-color=#f38ba8
text-color=#f38ba8
default-timeout=0
